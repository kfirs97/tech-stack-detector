{
  "actorSpecification": 1,
  "name": "tech-stack-detector",
  "title": "Tech Stack Detector — Wappalyzer Alternative",
  "description": "Find out what any website is built with: CMS, frameworks, analytics, CDN, e-commerce platform, hosting and 7,600+ other technologies. Fast, cheap, bulk-ready.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": { "fields": ["url", "statusCode", "technologyCount", "byCategory", "error"] },
          "display": {
            "component": "table",
            "properties": {
              "url": { "label": "Website", "format": "link" },
              "statusCode": { "label": "Status", "format": "number" },
              "technologyCount": { "label": "Technologies", "format": "number" },
              "byCategory": { "label": "By category", "format": "object" },
              "error": { "label": "Error", "format": "text" }
            }
          }
        }
      }
    }
  }
}
